--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios ]
flags:           [ flat_namespace ]
install-name:    "@loader_path/.jbroot/Library/Frameworks/AltList.framework/AltList"
current-version: 0
compatibility-version: 0
exports:
  - targets:         [ arm64-ios, arm64e-ios ]
    symbols:         [ _safe_getExecutablePath, _tagArrayContainsTag ]
    objc-classes:    [ ATLApplicationListControllerBase, ATLApplicationListMultiSelectionController, 
                       ATLApplicationListSelectionController, ATLApplicationListSubcontroller, 
                       ATLApplicationListSubcontrollerController, ATLApplicationSection, 
                       ATLApplicationSelectionCell, ATLApplicationSubtitleCell, 
                       ATLApplicationSubtitleSwitchCell ]
    objc-ivars:      [ ATLApplicationListControllerBase._allSpecifiers, 
                       ATLApplicationListControllerBase._altListBundle, 
                       ATLApplicationListControllerBase._applicationSections, 
                       ATLApplicationListControllerBase._iconLoadQueue, 
                       ATLApplicationListControllerBase._isPopulated, 
                       ATLApplicationListControllerBase._isReloadingSpecifiers, 
                       ATLApplicationListControllerBase._placeholderAppIcon, 
                       ATLApplicationListControllerBase._searchController, 
                       ATLApplicationListControllerBase._searchKey, 
                       ATLApplicationListControllerBase._specifiersByLetter, 
                       ATLApplicationListMultiSelectionController._defaultApplicationSwitchValue, 
                       ATLApplicationListMultiSelectionController._selectedApplications, 
                       ATLApplicationListSelectionController._selectedApplicationID, 
                       ATLApplicationSubtitleCell._customValueLabel ]
...
